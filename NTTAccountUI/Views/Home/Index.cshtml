@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var banners = ViewBag.Banners as IEnumerable<NTTAccountUI.Models.Entities.BannerSlide> ?? Enumerable.Empty<NTTAccountUI.Models.Entities.BannerSlide>();
    var bannerList = banners.ToList();
}

@section Styles {
    <style>
        /* ── Slider ── */
        .banner_slider_wrap {
            position: relative;
            width: 100%;
            min-height: 100vh;
            overflow: hidden;
            background: #0d0d0d;
        }
        /* ── Ürünler Section ── */
        .products_section {
            padding: 90px 0;
            background: linear-gradient(180deg, #0a0a12 0%, #0d0d1a 100%);
            position: relative;
        }

        .about_us_img img {
            max-width: 100%;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
            .products_section::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 1px;
                background: linear-gradient(90deg, transparent, #e84545, transparent);
            }

        /* Başlık */
        .products_badge {
            display: inline-block;
            background: rgba(232,69,69,0.1);
            color: #e84545;
            border: 1px solid rgba(232,69,69,0.3);
            border-radius: 20px;
            padding: 4px 18px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            margin-bottom: 16px;
        }

        .section_title h2 {
            color: #fff;
            font-size: 38px;
            font-weight: 700;
            margin-bottom: 12px;
            text-shadow: 0 0 40px rgba(232,69,69,0.3);
        }

        .section_title p {
            color: #666;
            font-size: 15px;
        }

        /* Özellik Bantları */
        .feature_badge {
            background: #111118;
            border: 1px solid #1e1e2e;
            border-radius: 10px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s;
        }

            .feature_badge:hover {
                border-color: #e84545;
                background: rgba(232,69,69,0.05);
            }

            .feature_badge i {
                font-size: 24px;
                color: #e84545;
                flex-shrink: 0;
            }

            .feature_badge span {
                color: #ccc;
                font-size: 13px;
                font-weight: 600;
            }

        /* Ürün Kartı */
        .product_card {
            background: #111118;
            border: 1px solid #1e1e2e;
            border-radius: 14px;
            padding: 28px 24px;
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: all 0.35s ease;
            position: relative;
            overflow: hidden;
        }

            .product_card::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, #e84545, #c62a88);
                opacity: 0;
                transition: opacity 0.3s;
            }

            .product_card:hover {
                border-color: rgba(232,69,69,0.5);
                transform: translateY(-8px);
                box-shadow: 0 24px 48px rgba(232,69,69,0.12);
            }

                .product_card:hover::after {
                    opacity: 1;
                }

        /* Kart Üst */
        .product_card_top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .product_icon_wrap {
            width: 48px;
            height: 48px;
            background: rgba(232,69,69,0.1);
            border: 1px solid rgba(232,69,69,0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .product_card:hover .product_icon_wrap {
            background: rgba(232,69,69,0.2);
            border-color: #e84545;
        }

        .product_icon_wrap i {
            font-size: 22px;
            color: #e84545;
        }

        .product_code {
            background: rgba(232,69,69,0.08);
            color: #e84545;
            border: 1px solid rgba(232,69,69,0.2);
            border-radius: 4px;
            padding: 3px 10px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .product_name {
            color: #fff;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .product_desc {
            color: #666;
            font-size: 13px;
            line-height: 1.7;
            margin-bottom: 18px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Özellik Listesi */
        .product_features {
            list-style: none;
            padding: 0;
            margin: 0 0 20px 0;
            flex: 1;
        }

            .product_features li {
                color: #777;
                font-size: 12px;
                padding: 5px 0;
                display: flex;
                align-items: center;
                gap: 8px;
                border-bottom: 1px solid #1a1a2a;
            }

                .product_features li:last-child {
                    border-bottom: none;
                }

                .product_features li i {
                    color: #e84545;
                    font-size: 14px;
                    flex-shrink: 0;
                }

        /* Footer */
        .product_footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid #1e1e2e;
            padding-top: 18px;
            margin-top: auto;
            gap: 12px;
        }

        .product_price {
            color: #e84545;
            font-size: 22px;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 6px;
        }

        .product_stock {
            font-size: 11px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .product_stock.ok {
                color: #28a745;
            }

            .product_stock.low {
                color: #ffc107;
            }

            .product_stock.out {
                color: #555;
            }

        .product_buy_btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(135deg, #e84545, #c62a88);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 10px 18px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.3s;
            font-family: 'Cinzel', serif;
            letter-spacing: 1px;
        }

            .product_buy_btn:hover {
                color: #fff;
                opacity: 0.85;
                transform: scale(1.04);
                text-decoration: none;
            }

            .product_buy_btn i {
                font-size: 16px;
            }

        /* Boş durum */
        .products_empty {
            text-align: center;
            padding: 80px 0;
            color: #555;
        }

            .products_empty i {
                font-size: 56px;
                margin-bottom: 20px;
                display: block;
                color: #2a2a3a;
            }
        .banner_slide {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            align-items: center;
            opacity: 0;
            transition: opacity 0.8s ease;
            pointer-events: none;
        }

            .banner_slide.active {
                opacity: 1;
                pointer-events: auto;
            }

            .banner_slide::before {
                content: '';
                position: absolute;
                inset: 0;
                background: rgba(0,0,0,0.55);
            }

            .banner_slide .container {
                position: relative;
                z-index: 2;
            }

        .banner_text_iner h1 {
            font-size: 48px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 20px;
            text-shadow: 0 2px 8px rgba(0,0,0,0.5);
        }

        .banner_text_iner p {
            font-size: 18px;
            color: rgba(255,255,255,0.85);
            margin-bottom: 30px;
            text-shadow: 0 1px 4px rgba(0,0,0,0.5);
        }

        /* Ok butonları */
        .slider-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: rgba(232,69,69,0.7);
            border: none;
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.3s;
        }

            .slider-btn:hover {
                background: #e84545;
            }

            .slider-btn.prev {
                left: 24px;
            }

            .slider-btn.next {
                right: 24px;
            }

        /* Dots */
        .slider-dots {
            position: absolute;
            bottom: 30px;
            width: 100%;
            display: flex;
            justify-content: center;
            gap: 8px;
            z-index: 10;
        }

        .slider-dot {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: rgba(255,255,255,0.4);
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            padding: 0;
        }

            .slider-dot.active {
                background: #e84545;
                width: 28px;
            }

        /* Progress bar */
        .slider-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            background: #e84545;
            z-index: 10;
            width: 0%;
        }

        /* Sayaç */
        .slider-counter {
            position: absolute;
            bottom: 36px;
            right: 30px;
            z-index: 10;
            color: rgba(255,255,255,0.6);
            font-size: 13px;
            letter-spacing: 1px;
        }
    </style>
}

@if (bannerList.Any())
{
    <div class="banner_slider_wrap" id="bannerWrap">

        @for (int i = 0; i < bannerList.Count; i++)
        {
            var banner = bannerList[i];
            <div class="banner_slide @(i == 0 ? "active" : "")"
                 style="background-image: url('@banner.Image');">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-7 col-md-9">
                            <div class="banner_text">
                                <div class="banner_text_iner">
                                    <h1>@banner.Title</h1>
                                    <p>@banner.Description</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (bannerList.Count > 1)
        {
            <button class="slider-btn prev" id="sliderPrev">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="slider-btn next" id="sliderNext">
                <i class="fas fa-chevron-right"></i>
            </button>

            <div class="slider-dots" id="sliderDots">
                @for (int i = 0; i < bannerList.Count; i++)
                {
                    <button class="slider-dot @(i == 0 ? "active" : "")" data-index="@i"></button>
                }
            </div>

            <div class="slider-counter" id="sliderCounter">1 / @bannerList.Count</div>
        }

        <div class="slider-progress" id="sliderProgress"></div>
    </div>
}
else
{
    <section class="banner_part">
        <div class="container">
            <div class="row align-items-center justify-content-between">
                <div class="col-lg-6 col-md-8">
                    <div class="banner_text">
                        <div class="banner_text_iner">
                            <h1>@(ViewBag.SiteName ?? "NTT Hesap")</h1>
                            <p>@(ViewBag.SiteDescription ?? "Knight Online")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
<!-- About -->
<section class="about_us section_padding">
    <div class="container">
        <div class="row align-items-center justify-content-between">

            <!-- Sol taraf yazılar -->
            <div class="col-md-6 col-lg-5">
                <div class="about_us_text">
                    <h2>@(ViewBag.SiteName ?? "NTT Hesap") Hakkında</h2>
                    <p>@(ViewBag.AboutText ?? ViewBag.SiteDescription ?? "Knight Online")</p>

                    <a href="/AdminLogin" class="btn_1">Giriş Yap</a>
                    <a href="/Contact" class="btn_1">İletişim</a>
                </div>
            </div>

            <!-- Sağ taraf görsel -->
            <div class="col-md-6 col-lg-7 text-center">
                <div class="about_us_img">
                    <img src="/img/about.png"
                         alt="About Image"
                         class="img-fluid"
                         loading="lazy"
                         decoding="async"
                         width="800"
                         height="800">
                </div>
            </div>

        </div>
    </div>
</section>
<!-- ✅ Ürünler Partial -->
@await Html.PartialAsync("_ProductList",
ViewBag.Products as IEnumerable<NTTAccountUI.Models.Entities.Product>
?? Enumerable.Empty<NTTAccountUI.Models.Entities.Product>())
@section Scripts {
    <script>
        (function () {
            var total      = @bannerList.Count;
            var current    = 0;
            var interval   = null;
            var duration   = 5000;
            var progTimer  = null;

            if (total <= 1) return;

            var slides   = document.querySelectorAll('.banner_slide');
            var dots     = document.querySelectorAll('.slider-dot');
            var counter  = document.getElementById('sliderCounter');
            var progress = document.getElementById('sliderProgress');

            function goTo(index) {
                slides[current].classList.remove('active');
                dots[current].classList.remove('active');

                current = (index + total) % total;

                slides[current].classList.add('active');
                dots[current].classList.add('active');

                if (counter) counter.textContent = (current + 1) + ' / ' + total;

                startProgress();
            }

            function next() { goTo(current + 1); }
            function prev() { goTo(current - 1); }

            function startAutoplay() {
                clearInterval(interval);
                interval = setInterval(next, duration);
            }

            function startProgress() {
                if (!progress) return;
                clearTimeout(progTimer);
                progress.style.transition = 'none';
                progress.style.width = '0%';
                progTimer = setTimeout(function () {
                    progress.style.transition = 'width ' + duration + 'ms linear';
                    progress.style.width = '100%';
                }, 50);
            }

            document.getElementById('sliderNext').addEventListener('click', function () {
                next();
                startAutoplay();
            });

            document.getElementById('sliderPrev').addEventListener('click', function () {
                prev();
                startAutoplay();
            });

            dots.forEach(function (dot) {
                dot.addEventListener('click', function () {
                    goTo(parseInt(this.getAttribute('data-index')));
                    startAutoplay();
                });
            });

            startAutoplay();
            startProgress();
        })();
    </script>
}
