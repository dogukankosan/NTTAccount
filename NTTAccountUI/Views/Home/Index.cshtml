@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var banners = ViewBag.Banners as IEnumerable<NTTAccountUI.Models.Entities.BannerSlide> ?? Enumerable.Empty<NTTAccountUI.Models.Entities.BannerSlide>();
    var bannerList = banners.ToList();
}

@section Styles {
    <style>
        /* ── Slider ── */
        .banner_slider_wrap {
            position: relative;
            width: 100%;
            min-height: 100vh;
            overflow: hidden;
            background: #0d0d0d;
        }

        .banner_slide {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            align-items: center;
            opacity: 0;
            transition: opacity 0.8s ease;
            pointer-events: none;
        }

            .banner_slide.active {
                opacity: 1;
                pointer-events: auto;
            }

            .banner_slide::before {
                content: '';
                position: absolute;
                inset: 0;
                background: rgba(0,0,0,0.55);
            }

            .banner_slide .container {
                position: relative;
                z-index: 2;
            }

        .banner_text_iner h1 {
            font-size: 48px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 20px;
            text-shadow: 0 2px 8px rgba(0,0,0,0.5);
        }

        .banner_text_iner p {
            font-size: 18px;
            color: rgba(255,255,255,0.85);
            margin-bottom: 30px;
            text-shadow: 0 1px 4px rgba(0,0,0,0.5);
        }

        /* Ok butonları */
        .slider-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: rgba(232,69,69,0.7);
            border: none;
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.3s;
        }

            .slider-btn:hover {
                background: #e84545;
            }

            .slider-btn.prev {
                left: 24px;
            }

            .slider-btn.next {
                right: 24px;
            }

        /* Dots */
        .slider-dots {
            position: absolute;
            bottom: 30px;
            width: 100%;
            display: flex;
            justify-content: center;
            gap: 8px;
            z-index: 10;
        }

        .slider-dot {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: rgba(255,255,255,0.4);
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            padding: 0;
        }

            .slider-dot.active {
                background: #e84545;
                width: 28px;
            }

        /* Progress bar */
        .slider-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            background: #e84545;
            z-index: 10;
            width: 0%;
        }

        /* Sayaç */
        .slider-counter {
            position: absolute;
            bottom: 36px;
            right: 30px;
            z-index: 10;
            color: rgba(255,255,255,0.6);
            font-size: 13px;
            letter-spacing: 1px;
        }
    </style>
}

@if (bannerList.Any())
{
    <div class="banner_slider_wrap" id="bannerWrap">

        @for (int i = 0; i < bannerList.Count; i++)
        {
            var banner = bannerList[i];
            <div class="banner_slide @(i == 0 ? "active" : "")"
                 style="background-image: url('@banner.Image');">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-7 col-md-9">
                            <div class="banner_text">
                                <div class="banner_text_iner">
                                    <h1>@banner.Title</h1>
                                    <p>@banner.Description</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (bannerList.Count > 1)
        {
            <button class="slider-btn prev" id="sliderPrev">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="slider-btn next" id="sliderNext">
                <i class="fas fa-chevron-right"></i>
            </button>

            <div class="slider-dots" id="sliderDots">
                @for (int i = 0; i < bannerList.Count; i++)
                {
                    <button class="slider-dot @(i == 0 ? "active" : "")" data-index="@i"></button>
                }
            </div>

            <div class="slider-counter" id="sliderCounter">1 / @bannerList.Count</div>
        }

        <div class="slider-progress" id="sliderProgress"></div>
    </div>
}
else
{
    <section class="banner_part">
        <div class="container">
            <div class="row align-items-center justify-content-between">
                <div class="col-lg-6 col-md-8">
                    <div class="banner_text">
                        <div class="banner_text_iner">
                            <h1>@(ViewBag.SiteName ?? "NTT Hesap")</h1>
                            <p>@(ViewBag.SiteDescription ?? "Knight Online")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- About -->
<section class="about_us section_padding">
    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-md-7 col-lg-6 col-xl-5">
                <div class="about_us_text">
                    <h2>@(ViewBag.SiteName ?? "NTT Hesap") Hakkında</h2>
                    <p>@(ViewBag.AboutText ?? ViewBag.SiteDescription ?? "Knight Online")</p>
                    <a href="/AdminLogin" class="btn_1">Giriş Yap</a>
                    <a href="/Contact" class="btn_1">İletişim</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var total      = @bannerList.Count;
            var current    = 0;
            var interval   = null;
            var duration   = 5000;
            var progTimer  = null;

            if (total <= 1) return;

            var slides   = document.querySelectorAll('.banner_slide');
            var dots     = document.querySelectorAll('.slider-dot');
            var counter  = document.getElementById('sliderCounter');
            var progress = document.getElementById('sliderProgress');

            function goTo(index) {
                slides[current].classList.remove('active');
                dots[current].classList.remove('active');

                current = (index + total) % total;

                slides[current].classList.add('active');
                dots[current].classList.add('active');

                if (counter) counter.textContent = (current + 1) + ' / ' + total;

                startProgress();
            }

            function next() { goTo(current + 1); }
            function prev() { goTo(current - 1); }

            function startAutoplay() {
                clearInterval(interval);
                interval = setInterval(next, duration);
            }

            function startProgress() {
                if (!progress) return;
                clearTimeout(progTimer);
                progress.style.transition = 'none';
                progress.style.width = '0%';
                progTimer = setTimeout(function () {
                    progress.style.transition = 'width ' + duration + 'ms linear';
                    progress.style.width = '100%';
                }, 50);
            }

            document.getElementById('sliderNext').addEventListener('click', function () {
                next();
                startAutoplay();
            });

            document.getElementById('sliderPrev').addEventListener('click', function () {
                prev();
                startAutoplay();
            });

            dots.forEach(function (dot) {
                dot.addEventListener('click', function () {
                    goTo(parseInt(this.getAttribute('data-index')));
                    startAutoplay();
                });
            });

            startAutoplay();
            startProgress();
        })();
    </script>
}
