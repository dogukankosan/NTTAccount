@model NTTAccountUI.Models.ViewModels.MailSettingsViewModel

@{
    ViewData["Title"] = "Mail Ayarlari";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var bannerClass = Model.TestPassed ? "alert-success" : "alert-warning";
    var bannerIcon = Model.TestPassed ? "mdi-check-circle" : "mdi-alert";
    var bannerText = Model.TestPassed
        ? "Test basarili! Ayarlari kaydedebilirsiniz."
        : "Kaydetmeden once test maili gondermeniz zorunludur.";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="mdi mdi-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4">
        <i class="mdi mdi-alert-circle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<div id="testStatusBanner" class="alert @bannerClass mb-4">
    <i class="mdi @bannerIcon mr-2"></i> @bannerText
</div>

<!-- Kaydet formu -->
<form asp-action="Save" asp-controller="AdminMailSettings" method="post" id="mailForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row">

        <div class="col-lg-8">

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title">SMTP Sunucu Ayarlari</h4>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">SMTP Sunucu <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input asp-for="SmtpHost" class="form-control" placeholder="smtp.gmail.com" id="smtpHost" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Port <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input asp-for="SmtpPort" class="form-control" type="number" id="smtpPort" />
                            <small class="text-muted d-block">587 (TLS) veya 465 (SSL)</small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Kullanici Adi <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input asp-for="SmtpUser" class="form-control" placeholder="ornek@gmail.com"
                                   id="smtpUser" autocomplete="off" />
                            <small class="text-muted d-block">Gonderici email otomatik dolacak.</small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Sifre</label>
                        <div class="col-sm-9">
                            <div style="position:relative;">
                                <input asp-for="SmtpPassword" type="password" class="form-control"
                                       id="smtpPwd" placeholder="Degistirmek icin girin"
                                       autocomplete="new-password" style="padding-left:40px;" />
                                <span id="togglePwd" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);cursor:pointer;color:#666;z-index:10;">
                                    <i class="mdi mdi-eye" id="eyeIcon"></i>
                                </span>
                            </div>
                            <small class="text-muted d-block">Bos birakilirsa mevcut sifre korunur.</small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">SSL/TLS</label>
                        <div class="col-sm-9 mt-2">
                            <div class="form-check">
                                <input asp-for="UseSsl" class="form-check-input" type="checkbox" id="useSsl" />
                                <label class="form-check-label" style="color:#ccc;">SSL/TLS Kullan</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title">Gonderici Bilgileri</h4>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Gonderici Adi <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input asp-for="FromName" class="form-control" placeholder="NTT Hesap" id="fromName" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Gonderici Email <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input asp-for="FromEmail" class="form-control" id="fromEmail"
                                   placeholder="ornek@gmail.com" />
                            <small class="text-muted d-block">Kullanici adi ile ayni girilmesi onerilir.</small>
                        </div>
                    </div>


                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title">HTML Imza</h4>
                    <small class="text-muted d-block mb-3">Her mailin altina otomatik eklenecek HTML imza.</small>
                    <textarea asp-for="Signature" class="form-control" rows="8" id="signatureEditor"
                              style="font-family:monospace;font-size:13px;"></textarea>
                    <div class="mt-3">
                        <button type="button" class="btn btn-sm btn-outline-info" id="previewBtn">
                            <i class="mdi mdi-eye mr-1"></i> Onizle
                        </button>
                    </div>
                    <div id="signaturePreview" class="mt-3"
                         style="display:none;background:#fff;color:#000;padding:16px;border-radius:6px;"></div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title">Test Maili Gonder</h4>
                    <p class="text-muted small">Kaydetmeden once zorunludur.</p>

                    <div class="form-group">
                        <label style="color:#aaa;">Test Email Adresi</label>
                        <input type="email" id="testEmailInput" class="form-control" placeholder="test@ornek.com" />
                    </div>

                    <button type="button" id="testBtn" class="btn btn-outline-info btn-block">
                        <i class="mdi mdi-send mr-1"></i> Test Gonder
                    </button>

                    <div id="testResult" class="mt-3" style="display:none;"></div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <button type="submit" id="saveBtn" class="btn btn-primary btn-block"
                            @(!Model.TestPassed ? "disabled" : "")>
                        <i class="mdi mdi-content-save mr-1"></i> Kaydet
                    </button>
                    @if (!Model.TestPassed)
                    {
                        <small class="text-muted d-block text-center mt-2">Test basarili olunca aktif olur.</small>
                    }
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <script>
        var testPassed = @(Model.TestPassed ? "true" : "false");

        // SmtpUser yazilinca FromEmail anlik dolsun
        document.getElementById('smtpUser').addEventListener('input', function () {
            document.getElementById('fromEmail').value = this.value;
        });

        // Sifre goster/gizle
        document.getElementById('togglePwd').addEventListener('click', function () {
            var input = document.getElementById('smtpPwd');
            var icon  = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('mdi-eye', 'mdi-eye-off');
            } else {
                input.type = 'password';
                icon.classList.replace('mdi-eye-off', 'mdi-eye');
            }
        });

        // Form degisince test sifirla
        ['smtpHost','smtpPort','smtpUser','smtpPwd','fromName','fromEmail','useSsl'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.addEventListener('change', function () {
                if (testPassed) {
                    testPassed = false;
                    document.getElementById('saveBtn').disabled = true;
                    document.getElementById('testStatusBanner').className = 'alert alert-warning mb-4';
                    document.getElementById('testStatusBanner').innerHTML =
                        '<i class="mdi mdi-alert mr-2"></i> Form degistirildi. Tekrar test maili gondermeniz gerekiyor.';
                }
            });
        });

        // Test gonder
        document.getElementById('testBtn').addEventListener('click', function () {
            var btn      = this;
            var testEmail = document.getElementById('testEmailInput').value.trim();

            if (!testEmail) {
                Swal.fire({ title: 'Hata!', text: 'Test email adresi giriniz.', icon: 'warning',
                    confirmButtonColor: '#e84545', background: '#1a1a2e', color: '#fff' });
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="mdi mdi-loading mdi-spin mr-1"></i> Gonderiliyor...';

            var token = document.querySelector('[name="__RequestVerificationToken"]').value;

            var payload = {
                Id:           parseInt(document.querySelector('[name="Id"]').value) || 0,
                SmtpHost:     document.getElementById('smtpHost').value,
                SmtpPort:     parseInt(document.getElementById('smtpPort').value) || 587,
                SmtpUser:     document.getElementById('smtpUser').value,
                SmtpPassword: document.getElementById('smtpPwd').value,
                FromName:     document.getElementById('fromName').value,
                FromEmail:    document.getElementById('fromEmail').value,
                UseSsl:       document.getElementById('useSsl').checked,
                TestEmail:    testEmail,
                Signature:    document.getElementById('signatureEditor').value
            };

            fetch('/AdminMailSettings/SendTest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                var resultDiv = document.getElementById('testResult');
                resultDiv.style.display = 'block';

                if (res.success) {
                    testPassed = true;
                    document.getElementById('saveBtn').disabled = false;
                    document.getElementById('testStatusBanner').className = 'alert alert-success mb-4';
                    document.getElementById('testStatusBanner').innerHTML =
                        '<i class="mdi mdi-check-circle mr-2"></i> Test basarili! Ayarlari kaydedebilirsiniz.';
                    resultDiv.innerHTML =
                        '<div class="alert alert-success"><i class="mdi mdi-check-circle mr-1"></i> Test maili gonderildi!</div>';
                } else {
                    testPassed = false;
                    document.getElementById('saveBtn').disabled = true;
                    resultDiv.innerHTML =
                        '<div class="alert alert-danger"><i class="mdi mdi-alert-circle mr-1"></i> Hata: ' + (res.error || 'Bilinmeyen hata') + '</div>';
                }

                btn.disabled = false;
                btn.innerHTML = '<i class="mdi mdi-send mr-1"></i> Test Gonder';
            })
            .catch(function (err) {
                document.getElementById('testResult').style.display = 'block';
                document.getElementById('testResult').innerHTML =
                    '<div class="alert alert-danger">Baglanti hatasi: ' + err + '</div>';
                btn.disabled = false;
                btn.innerHTML = '<i class="mdi mdi-send mr-1"></i> Test Gonder';
            });
        });

        // Imza onizle
        document.getElementById('previewBtn').addEventListener('click', function () {
            var html    = document.getElementById('signatureEditor').value;
            var preview = document.getElementById('signaturePreview');
            preview.innerHTML     = html || '<p>Imza bos.</p>';
            preview.style.display = preview.style.display === 'none' ? 'block' : 'none';
        });

        // Submit kontrolu
        document.getElementById('mailForm').addEventListener('submit', function (e) {
            if (!testPassed) {
                e.preventDefault();
                Swal.fire({ title: 'Test Gerekli!', text: 'Once test maili gondermelisiniz.',
                    icon: 'warning', confirmButtonColor: '#e84545', background: '#1a1a2e', color: '#fff' });
                return;
            }
            var btn = document.getElementById('saveBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="mdi mdi-loading mdi-spin mr-1"></i> Kaydediliyor...';
        });
    </script>
}
