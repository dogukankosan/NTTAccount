@using NTTAccountUI.Helpers
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 style="color:#fff;">
            Hoş Geldiniz, <span style="color:#e84545;">@(ViewBag.AdminEmail ?? "Admin")</span>
        </h4>
        <p class="text-muted small">
            @DateTime.Now.ToString("dd MMMM yyyy, dddd",
            new System.Globalization.CultureInfo("tr-TR"))
        </p>
    </div>
</div>

<!-- İstatistik Kartları — Satır 1 -->
<div class="row mb-2">

    <!-- Kullanıcılar -->
    <div class="col-xl-3 col-sm-6 mb-4">
        <a href="/AdminUser" style="text-decoration:none;">
            <div class="card stat-card" style="border-left:4px solid #e84545;">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">Toplam Kullanıcı</p>
                            <h3 style="color:#fff;margin:0;">@(ViewBag.TotalUsers ?? 0)</h3>
                            <small class="text-success">
                                <i class="mdi mdi-check-circle mr-1"></i>
                                @(ViewBag.ActiveUsers ?? 0) Aktif
                            </small>
                        </div>
                        <div class="stat-icon" style="background:rgba(232,69,69,0.15);">
                            <i class="mdi mdi-account-multiple" style="color:#e84545;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Siparişler -->
    <div class="col-xl-3 col-sm-6 mb-4">
        <a href="/AdminOrder" style="text-decoration:none;">
            <div class="card stat-card" style="border-left:4px solid #28a745;">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">Toplam Sipariş</p>
                            <h3 style="color:#fff;margin:0;">@(ViewBag.TotalOrders ?? 0)</h3>
                            <small class="text-warning">
                                <i class="mdi mdi-clock-outline mr-1"></i>
                                @(ViewBag.PendingOrders ?? 0) Bekliyor
                            </small>
                        </div>
                        <div class="stat-icon" style="background:rgba(40,167,69,0.15);">
                            <i class="mdi mdi-clipboard-list" style="color:#28a745;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Ürünler -->
    <div class="col-xl-3 col-sm-6 mb-4">
        <a href="/AdminProduct" style="text-decoration:none;">
            <div class="card stat-card" style="border-left:4px solid #17a2b8;">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">Toplam Ürün</p>
                            <h3 style="color:#fff;margin:0;">@(ViewBag.TotalProducts ?? 0)</h3>
                            <small class="text-info">
                                <i class="mdi mdi-check mr-1"></i>
                                @(ViewBag.ActiveProducts ?? 0) Aktif
                            </small>
                        </div>
                        <div class="stat-icon" style="background:rgba(23,162,184,0.15);">
                            <i class="mdi mdi-package-variant" style="color:#17a2b8;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Toplam Gelir -->
    <div class="col-xl-3 col-sm-6 mb-4">
        <div class="card stat-card" style="border-left:4px solid #f39c12;">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Toplam Ciro</p>
                        <h3 style="color:#fff;margin:0;font-size:20px;">
                            @(((decimal)(ViewBag.TotalRevenue ?? 0m)).ToString("N2")) ₺
                        </h3>
                        <small class="text-success">
                            <i class="mdi mdi-check-all mr-1"></i>
                            @(ViewBag.ClosedOrders ?? 0) Kapandı
                        </small>
                    </div>
                    <div class="stat-icon" style="background:rgba(243,156,18,0.15);">
                        <i class="mdi mdi-currency-try" style="color:#f39c12;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- İstatistik Kartları — Satır 2 -->
<div class="row mb-4">

    <!-- Mesajlar -->
    <div class="col-xl-3 col-sm-6 mb-4">
        <a href="/AdminContact" style="text-decoration:none;">
            <div class="card stat-card" style="border-left:4px solid #6f42c1;">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">İletişim Mesajları</p>
                            <h3 style="color:#fff;margin:0;">@(ViewBag.TotalContacts ?? 0)</h3>
                            @if ((ViewBag.UnreadContacts ?? 0) > 0)
                            {
                                <small class="text-warning">
                                    <i class="mdi mdi-email-outline mr-1"></i>
                                    @(ViewBag.UnreadContacts) Okunmamış
                                </small>
                            }
                            else
                            {
                                <small class="text-success">
                                    <i class="mdi mdi-check mr-1"></i>Tümü Okundu
                                </small>
                            }
                        </div>
                        <div class="stat-icon" style="background:rgba(111,66,193,0.15);">
                            <i class="mdi mdi-email" style="color:#6f42c1;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Kısmı Sevk -->
    <div class="col-xl-3 col-sm-6 mb-4">
        <a href="/AdminOrder" style="text-decoration:none;">
            <div class="card stat-card" style="border-left:4px solid #17a2b8;">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">Kısmı Sevk</p>
                            <h3 style="color:#fff;margin:0;">@(ViewBag.PartialOrders ?? 0)</h3>
                            <small class="text-info">
                                <i class="mdi mdi-truck-delivery mr-1"></i>
                                Devam Ediyor
                            </small>
                        </div>
                        <div class="stat-icon" style="background:rgba(23,162,184,0.15);">
                            <i class="mdi mdi-truck-delivery" style="color:#17a2b8;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Bannerlar -->
    <div class="col-xl-3 col-sm-6 mb-4">
        <a href="/AdminBannerSlide" style="text-decoration:none;">
            <div class="card stat-card" style="border-left:4px solid #3498db;">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">Banner</p>
                            <h3 style="color:#fff;margin:0;">@(ViewBag.TotalBanners ?? 0)</h3>
                            <small class="text-info">
                                <i class="mdi mdi-eye mr-1"></i>
                                @(ViewBag.ActiveBanners ?? 0) Aktif
                            </small>
                        </div>
                        <div class="stat-icon" style="background:rgba(52,152,219,0.15);">
                            <i class="mdi mdi-image-multiple" style="color:#3498db;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Hata Logları -->
    <div class="col-xl-3 col-sm-6 mb-4">
        <a href="/AdminLog" style="text-decoration:none;">
            <div class="card stat-card" style="border-left:4px solid #e74c3c;">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">Hata Logları</p>
                            <h3 style="color:#fff;margin:0;">@(ViewBag.TotalLogs ?? 0)</h3>
                            @if ((ViewBag.ErrorLogs ?? 0) > 0)
                            {
                                <small class="text-danger">
                                    <i class="mdi mdi-alert-circle mr-1"></i>
                                    @(ViewBag.ErrorLogs) Kritik
                                </small>
                            }
                            else
                            {
                                <small class="text-success">
                                    <i class="mdi mdi-check mr-1"></i>Sorun Yok
                                </small>
                            }
                        </div>
                        <div class="stat-icon" style="background:rgba(231,76,60,0.15);">
                            <i class="mdi mdi-bug" style="color:#e74c3c;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

</div>

<!-- İçerik Satırı -->
<div class="row">

    <!-- Son Siparişler -->
    <div class="col-lg-8 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 style="color:#fff;margin:0;">
                        <i class="mdi mdi-clipboard-list mr-2" style="color:#e84545;"></i>
                        Son Siparişler
                    </h5>
                    <a href="/AdminOrder" class="btn btn-sm btn-outline-primary">Tümü</a>
                </div>
                @{
                    var recentOrders = ViewBag.RecentOrders as List<NTTAccountUI.Models.Entities.Order>;
                }
                @if (recentOrders == null || !recentOrders.Any())
                {
                    <p class="text-muted text-center py-3">Henüz sipariş yok.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0" style="font-size:13px;">
                            <thead style="background:#111118;">
                                <tr>
                                    <th style="color:#888;">Sipariş No</th>
                                    <th style="color:#888;">Kullanıcı</th>
                                    <th style="color:#888;">Satır</th>
                                    <th style="color:#888;">Durum</th>
                                    <th style="color:#888;">Tarih</th>
                                    <th style="color:#888;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in recentOrders)
                                {
                                    var sc = order.Status == 0 ? "warning"
                                    : order.Status == 1 ? "info" : "success";
                                    var st = order.Status == 0 ? "Bekliyor"
                                    : order.Status == 1 ? "Kısmı Sevk" : "Kapandı";
                                    <tr style="border-bottom:1px solid #1a1a2e;">
                                        <td>
                                            <span style="color:#e84545;font-weight:700;">
                                                @order.OrderNo
                                            </span>
                                        </td>
                                        <td class="text-muted">@order.UserEmail</td>
                                        <td class="text-muted">@order.Items.Count adet</td>
                                        <td>
                                            <span class="badge badge-@sc">@st</span>
                                        </td>
                                        <td class="text-muted">
                                            @order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Edit", "AdminOrder", new { id = order.Id })"
                                               class="btn btn-xs btn-warning"
                                               style="padding:2px 8px;font-size:11px;">
                                                <i class="mdi mdi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Düşük Stok Ürünler -->
    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 style="color:#fff;margin:0;">
                        <i class="mdi mdi-alert-circle mr-2" style="color:#f39c12;"></i>
                        Düşük Stok
                    </h5>
                    <a href="/AdminProduct" class="btn btn-sm btn-outline-warning">Tümü</a>
                </div>
                @{
                    var lowStock = ViewBag.LowStockProducts as
                    List<NTTAccountUI.Models.Entities.Product>;
                }
                @if (lowStock == null || !lowStock.Any())
                {
                    <p class="text-success text-center py-3">
                        <i class="mdi mdi-check-circle mr-1"></i>
                        Tüm ürünlerde yeterli stok var.
                    </p>
                }
                else
                {
                    @foreach (var p in lowStock)
                    {
                        var stockColor = p.Stock == 0 ? "#e84545"
                        : p.Stock <= 2 ? "#e74c3c" : "#f39c12";
                        <div style="padding:10px 0;border-bottom:1px solid #1e1e2e;">
                            <div class="d-flex justify-content-between align-items-center">
                                <div style="flex:1;min-width:0;">
                                    <p style="color:#fff;margin:0;font-size:13px;
                                                       overflow:hidden;text-overflow:ellipsis;
                                                       white-space:nowrap;">
                                        @p.Name
                                    </p>
                                    <small class="text-muted">@p.Code</small>
                                </div>
                                <div class="text-right ml-2">
                                    @if (p.Stock == 0)
                                    {
                                        <span class="badge badge-danger">Tükendi</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">
                                            @p.Stock adet
                                        </span>
                                    }
                                </div>
                            </div>
                            <!-- Stok bar -->
                            <div class="progress mt-1" style="height:3px;background:#1e1e2e;">
                                <div class="progress-bar"
                                     style="width:@(Math.Min(p.Stock * 20, 100))%;
                                                    background:@stockColor;"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Son Mesajlar -->
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 style="color:#fff;margin:0;">Son Mesajlar</h5>
                    <a href="/AdminContact" class="btn btn-sm btn-outline-primary">Tümü</a>
                </div>
                @{
                    var recentContacts = ViewBag.RecentContacts as
                    List<NTTAccountUI.Models.Entities.Contact>;
                }
                @if (recentContacts == null || !recentContacts.Any())
                {
                    <p class="text-muted text-center py-3">Henüz mesaj yok.</p>
                }
                else
                {
                    @foreach (var c in recentContacts)
                    {
                        <div style="padding:10px 0;border-bottom:1px solid #1e1e30;
                                            display:flex;align-items:center;
                                            justify-content:space-between;">
                            <div>
                                <p style="color:#fff;margin:0;font-size:13px;
                                                   font-weight:@(!c.IsRead ? "700" : "400")">
                                    @c.FullName
                                </p>
                                <p class="text-muted"
                                   style="margin:0;font-size:12px;overflow:hidden;
                                                  text-overflow:ellipsis;white-space:nowrap;
                                                  max-width:200px;">
                                    @c.Subject
                                </p>
                            </div>
                            <div class="text-right">
                                @if (!c.IsRead)
                                {
                                    <span class="badge badge-warning"
                                          style="font-size:10px;">Yeni</span>
                                }
                                <p class="text-muted"
                                   style="margin:2px 0 0;font-size:11px;">
                                    @c.CreatedAt.ToTurkeyTimeString("dd.MM HH:mm")
                                </p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Son Kullanıcılar -->
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 style="color:#fff;margin:0;">Son Kullanıcılar</h5>
                    <a href="/AdminUser" class="btn btn-sm btn-outline-primary">Tümü</a>
                </div>
                @{
                    var recentUsers = ViewBag.RecentUsers as
                    List<NTTAccountUI.Models.Entities.User>;
                }
                @if (recentUsers == null || !recentUsers.Any())
                {
                    <p class="text-muted text-center py-3">Henüz kullanıcı yok.</p>
                }
                else
                {
                    @foreach (var u in recentUsers)
                    {
                        <div style="padding:10px 0;border-bottom:1px solid #1e1e30;
                                            display:flex;align-items:center;gap:12px;">
                            @if (!string.IsNullOrEmpty(u.ProfileImage))
                            {
                                <img src="@u.ProfileImage"
                                     style="width:32px;height:32px;border-radius:50%;
                                                        object-fit:cover;flex-shrink:0;" />
                            }
                            else
                            {
                                <div style="width:32px;height:32px;border-radius:50%;
                                                        background:linear-gradient(135deg,#e84545,#c62a88);
                                                        display:flex;align-items:center;
                                                        justify-content:center;flex-shrink:0;">
                                    <i class="mdi mdi-account"
                                       style="color:#fff;font-size:14px;"></i>
                                </div>
                            }
                            <div style="flex:1;min-width:0;">
                                <p style="color:#fff;margin:0;font-size:13px;overflow:hidden;
                                                   text-overflow:ellipsis;white-space:nowrap;">
                                    @u.Email
                                </p>
                                <p class="text-muted"
                                   style="margin:0;font-size:11px;">
                                    @u.CreatedAt.ToTurkeyTimeString("dd.MM.yyyy")
                                </p>
                            </div>
                            @if (u.RoleId == 1)
                            {
                                <span class="badge badge-danger"
                                      style="font-size:10px;">Admin</span>
                            }
                            else
                            {
                                <span class="badge badge-info"
                                      style="font-size:10px;">User</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Son Loglar -->
    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 style="color:#fff;margin:0;">Son Hata Logları</h5>
                    <a href="/AdminLog" class="btn btn-sm btn-outline-danger">Tümü</a>
                </div>
                @{
                    var recentLogs = ViewBag.RecentLogs as
                    List<NTTAccountUI.Models.Entities.ErrorLog>;
                }
                @if (recentLogs == null || !recentLogs.Any())
                {
                    <p class="text-success text-center py-3">
                        <i class="mdi mdi-check-circle mr-2"></i>
                        Hiç hata logu yok, sistem sağlıklı!
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th style="width:90px;">Seviye</th>
                                    <th>Mesaj</th>
                                    <th style="width:130px;">Tarih</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in recentLogs)
                                {
                                    var bc = log.Level switch
                                    {
                                        "Critical" => "badge-danger",
                                        "Error" => "badge-danger",
                                        "Warning" => "badge-warning",
                                        _ => "badge-info"
                                    };
                                    <tr>
                                        <td>
                                            <span class="badge @bc">@log.Level</span>
                                        </td>
                                        <td class="text-muted small"
                                            style="max-width:400px;overflow:hidden;
                                                           text-overflow:ellipsis;white-space:nowrap;">
                                            @log.Message
                                        </td>
                                        <td class="text-muted small">
                                            @log.CreatedAt.ToTurkeyTimeString()
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@section Styles {
    <style>
        .stat-card {
            transition: transform 0.2s;
        }

            .stat-card:hover {
                transform: translateY(-4px);
            }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .stat-icon i {
                font-size: 24px;
            }
    </style>
}
