@model IEnumerable<NTTAccountUI.Models.Entities.BannerSlide>

@{
    ViewData["Title"] = "Banner Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="mdi mdi-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4">
        <i class="mdi mdi-alert-circle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h4 class="mb-0" style="color:#fff;">Banner Listesi</h4>
        <a href="/AdminBannerSlide/Create" class="btn btn-primary">
            <i class="mdi mdi-plus mr-1"></i> Yeni Banner Ekle
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:80px;">Görsel</th>
                        <th>Başlık</th>
                        <th>Açıklama</th>
                        <th style="width:80px;">Sıra</th>
                        <th style="width:90px;">Durum</th>
                        <th style="width:160px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Henüz banner eklenmemiş.</td>
                        </tr>
                    }
                    @foreach (var slide in Model)
                    {
                        <tr>
                            <td>
                                <img src="@slide.Image" alt="@slide.Title"
                                     style="width:60px;height:40px;object-fit:cover;border-radius:4px;" />
                            </td>
                            <td style="color:#fff;">@slide.Title</td>
                            <td class="text-muted" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @slide.Description
                            </td>
                            <td class="text-muted">@slide.OrderNo</td>
                            <td>
                                @if (slide.IsActive)
                                {
                                    <span class="badge badge-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Pasif</span>
                                }
                            </td>
                            <td>
                                <!-- Düzenle -->
                                <a href="/AdminBannerSlide/Edit/@slide.Id"
                                   class="btn btn-sm btn-outline-primary mr-1" title="Düzenle">
                                    <i class="mdi mdi-pencil"></i>
                                </a>

                                <!-- Aktif/Pasif -->
                                <form asp-action="ToggleActive" asp-controller="AdminBannerSlide"
                                      method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@slide.Id" />
                                    <button type="submit"
                                            class="btn btn-sm @(slide.IsActive ? "btn-outline-warning" : "btn-outline-success") mr-1"
                                            title="@(slide.IsActive ? "Pasif Yap" : "Aktif Yap")">
                                        <i class="mdi @(slide.IsActive ? "mdi-eye-off" : "mdi-eye")"></i>
                                    </button>
                                </form>

                                <!-- Sil -->
                                <form asp-action="Delete" asp-controller="AdminBannerSlide"
                                      method="post" style="display:inline;"
                                      class="delete-form" data-title="@slide.Title">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@slide.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="mdi mdi-delete"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.delete-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var title = this.getAttribute('data-title');
                var submitForm = this;

                Swal.fire({
                    title: 'Emin misiniz?',
                    text: '"' + title + '" adlı banner silinecek. Bu işlem geri alınamaz!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e84545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'İptal',
                    background: '#1a1a2e',
                    color: '#fff'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        submitForm.submit();
                    }
                });
            });
        });
    </script>
}
