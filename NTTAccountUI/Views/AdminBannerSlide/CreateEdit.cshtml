@model NTTAccountUI.Models.ViewModels.BannerSlideViewModel

@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Banner Düzenle" : "Banner Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger mb-4">
        <i class="mdi mdi-alert-circle mr-2"></i>
        @Html.ValidationSummary(false)
    </div>
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="AdminBannerSlide"
      method="post" enctype="multipart/form-data" id="bannerForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Image" id="ImageBase64" />

    <div class="row">

        <!-- Sol - Form -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title">@(isEdit ? "Banner Bilgilerini Güncelle" : "Yeni Banner Ekle")</h4>

                    <div class="form-group">
                        <label style="color:#aaa;">Başlık <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="Banner başlığı" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label style="color:#aaa;">Açıklama <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Banner açıklaması"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                        <small class="text-muted">Maks. 500 karakter</small>
                    </div>

                    <div class="form-group row">
                        <div class="col-sm-6">
                            <label style="color:#aaa;">Sıra No</label>
                            <input asp-for="OrderNo" class="form-control" type="number" min="0" placeholder="0" />
                            <small class="text-muted">Küçük sayı önce gösterilir</small>
                        </div>
                        <div class="col-sm-6">
                            <label style="color:#aaa;">Durum</label>
                            <div class="mt-2">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                                    <label class="form-check-label" for="isActiveCheck" style="color:#ccc;">Aktif</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ - Görsel -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body text-center">
                    <h4 class="card-title">Görsel <span class="text-danger">*</span></h4>

                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image" id="imagePreview"
                             style="width:100%;height:140px;object-fit:cover;border-radius:6px;margin-bottom:12px;display:block;" />
                    }
                    else
                    {
                        <div id="imagePreview"
                             style="width:100%;height:140px;background:#1a1a2e;display:flex;align-items:center;justify-content:center;margin-bottom:12px;border-radius:6px;border:2px dashed #2a2a4a;">
                            <div>
                                <i class="mdi mdi-image-outline" style="font-size:40px;color:#444;display:block;"></i>
                                <span style="color:#555;font-size:12px;">Görsel seçin</span>
                            </div>
                        </div>
                    }

                    <input type="file" id="imageInput" accept="image/*" class="form-control-file" />
                    <small class="text-muted d-block mt-1">PNG, JPG, WEBP — Önerilen: 1920x1080 — Maks. 5MB</small>
                    @if (!isEdit)
                    {
                        <small class="text-danger d-block mt-1">* Yeni banner için görsel zorunludur.</small>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <button type="submit" id="saveBtn" class="btn btn-primary btn-block">
                        <i class="mdi mdi-content-save mr-1"></i> @(isEdit ? "Güncelle" : "Kaydet")
                    </button>
                    <a href="/AdminBannerSlide" class="btn btn-outline-secondary btn-block mt-2">
                        <i class="mdi mdi-arrow-left mr-1"></i> Geri Dön
                    </a>
                </div>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    <script>
        document.getElementById('imageInput').addEventListener('change', function () {
            var file = this.files[0];
            if (!file) return;

            // Dosya tipi kontrolü
            if (!file.type.startsWith('image/')) {
                Swal.fire({
                    title: 'Geçersiz Dosya!',
                    text: 'Sadece resim dosyası yükleyebilirsiniz. (JPG, PNG, WEBP vb.)',
                    icon: 'error',
                    confirmButtonColor: '#e84545',
                    background: '#1a1a2e',
                    color: '#fff'
                });
                this.value = '';
                return;
            }

            // Boyut kontrolü
            if (file.size > 5 * 1024 * 1024) {
                Swal.fire({
                    title: 'Dosya Çok Büyük!',
                    text: 'Dosya boyutu 5MB\'dan büyük olamaz.',
                    icon: 'warning',
                    confirmButtonColor: '#e84545',
                    background: '#1a1a2e',
                    color: '#fff'
                });
                this.value = '';
                return;
            }

            var reader = new FileReader();
            reader.onload = function (e) {
                var base64  = e.target.result;
                var preview = document.getElementById('imagePreview');

                if (preview.tagName === 'IMG') {
                    preview.src = base64;
                } else {
                    var img = document.createElement('img');
                    img.id = 'imagePreview';
                    img.src = base64;
                    img.style.cssText = 'width:100%;height:140px;object-fit:cover;border-radius:6px;margin-bottom:12px;display:block;';
                    preview.parentNode.replaceChild(img, preview);
                }

                document.getElementById('ImageBase64').value = base64;
            };
            reader.readAsDataURL(file);
        });

        document.getElementById('bannerForm').addEventListener('submit', function () {
            var btn = document.getElementById('saveBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="mdi mdi-loading mdi-spin mr-1"></i> Kaydediliyor...';
        });
    </script>
}
